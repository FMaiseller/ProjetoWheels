@page
@model ProjetoWheels.Pages.Relatorios.IndexModel
@{
}
<h1 class="mb-4">
    Relatórios
</h1>

<form method="get">

    <div>
        <h4>Adicionar Filtro</h4>
        <label>Data Inicial</label>
        <input type="date"
               name="dataInicio"
               value="@Model.Relatorio.DataInicio?.ToString("yyyy-MM-dd")" />
    </div>

    <div>
        <label>Data Final</label>
        <input type="date"
               name="dataFim"
               value="@Model.Relatorio.DataFim?.ToString("yyyy-MM-dd")" />
    </div>

    <button type="submit" class="col-md-1 mt-4 btn btn-outline-primary btn-lg">
        
        Filtrar
    </button>

</form>

<div class="mt-4 row g-4">

    <div class="col-md-3">

        <div class="card text-white bg-success shadow">

            <div class="card-body">

                <h5 class="card-title">
                    Receita Total
                </h5>

                <h2>
                    @Model.Relatorio.ReceitaTotal.ToString("C")
                </h2>

            </div>

        </div>

    </div>

    <div class="col-md-3">

        <div class="card text-white bg-primary shadow">

            <div class="card-body">

                <h5 class="card-title">
                    Total de Locações
                </h5>

                <h2>
                    @Model.Relatorio.TotalLocacoes
                </h2>

            </div>

        </div>

    </div>

    <div class="col-md-3">

        <div class="card text-dark bg-warning shadow">

            <div class="card-body">

                <h5 class="card-title">
                    Bikes Disponíveis
                </h5>

                <h2>
                    @Model.Relatorio.BicicletasDisponiveis
                </h2>

            </div>

        </div>

    </div>

    <div class="col-md-3">

        <div class="card text-white bg-danger shadow">

            <div class="card-body">

                <h5 class="card-title">
                    Bikes Alugadas
                </h5>

                <h2>
                    @Model.Relatorio.BicicletasAlugadas
                </h2>

            </div>

        </div>

    </div>

</div>

<div class="row mt-4 g-4">

    <div class="col-md-6">

        <div class="card shadow">

            <div class="card-body">

                <h4>
                    Cliente com Mais Locações
                </h4>

                <p class="fs-4">
                    @Model.Relatorio.ClienteMaisLocacoes
                </p>

            </div>

        </div>

    </div>

    <div class="col-md-6">

        <div class="card shadow">

            <div class="card-body">

                <h4>
                    Bicicleta Mais Alugada
                </h4>

                <p class="fs-4">
                    @Model.Relatorio.BicicletaMaisAlugada
                </p>

            </div>

        </div>

    </div>

</div>