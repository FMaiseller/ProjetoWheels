@page
@using ProjetoWheels.Models
@model ProjetoWheels.Pages.Bicicletas.DeleteModel
@{
}
<h1 class="mb-4 text-danger">
    Excluir Bicicleta
</h1>

<div class="card shadow-sm border-danger">

    <div class="card-body">

        <h5 class="mb-4">
            Tem certeza que deseja excluir esta bicicleta?
        </h5>

        <dl class="row">

            <dt class="col-sm-2">
                Marca
            </dt>

            <dd class="col-sm-10">
                @Model.Bicicleta.Marca
            </dd>

            <dt class="col-sm-2">
                Tipo
            </dt>

            <dd class="col-sm-10">
                @Model.Bicicleta.Tipo
            </dd>

            <dt class="col-sm-2">
                Tamanho
            </dt>

            <dd class="col-sm-10">
                @Model.Bicicleta.Tamanho
            </dd>

            <dt class="col-sm-2">
                ValorDiaria
            </dt>

            <dd class="col-sm-10">
                @Model.Bicicleta.ValorDiaria
            </dd>

            <dt class="col-sm-2">
                Status
            </dt>

            <dd class="col-sm-10">
                @Model.Bicicleta.Status
            </dd>


        </dl>

        <form method="post">

            <input type="hidden" asp-for="Bicicleta.Id" />

            <button type="submit" class="btn btn-danger">
                Excluir
            </button>

            <a asp-page="Index" class="btn btn-secondary">
                Cancelar
            </a>

        </form>

    </div>

</div>