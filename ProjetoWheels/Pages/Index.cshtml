@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}

<div class="p-5 mb-4 mt-4 bg-primary text-white rounded-4 shadow">

    <div class="container-fluid py-3">

        <h1 class="display-4 fw-bold">
            Projeto Wheels
        </h1>

        <p class="fs-5">

            Sistema de gerenciamento de locação de bicicletas.

        </p>

        <a asp-page="/Locacoes/Create"
           class="btn btn-light btn-lg">

            Nova Locação

        </a>

    </div>

</div>

<div class="mt-5">

    <h3 class="mb-4">
        Acesso Rápido
    </h3>

    <div class="d-flex gap-3 flex-wrap">

        <a asp-page="/Clientes/Index"
           class="btn btn-outline-primary btn-lg">

            Clientes

        </a>

        <a asp-page="/Bicicletas/Index"
           class="btn btn-outline-success btn-lg">

            Bicicletas

        </a>

        <a asp-page="/Locacoes/Index"
           class="btn btn-outline-danger btn-lg">

            Locações

        </a>

        <a asp-page="/Relatorios/Index"
           class="btn btn-outline-dark btn-lg">

            Relatórios

        </a>

    </div>

</div>
