@page
@model ProjetoWheels.Pages.Clientes.EditModel
@{
}
<h1 class="mb-4">Editar Cliente</h1>

<div class="card shadow-sm">
    <div class="card-body">

        <form method="post">

            <input type="hidden" asp-for="Cliente.Id" />

            <div class="mb-3">
                <label asp-for="Cliente.Nome" class="form-label"></label>

                <input asp-for="Cliente.Nome" class="form-control" />

                <span asp-validation-for="Cliente.Nome"
                      class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Cliente.CPF" class="form-label"></label>

                <input asp-for="Cliente.CPF" class="form-control" />

                <span asp-validation-for="Cliente.CPF"
                      class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Cliente.Telefone" class="form-label"></label>

                <input asp-for="Cliente.Telefone" class="form-control" />
            </div>

            <div class="mb-3">
                <label asp-for="Cliente.Email" class="form-label"></label>

                <input asp-for="Cliente.Email" class="form-control" />

                <span asp-validation-for="Cliente.Email"
                      class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-warning">
                Salvar Alterações
            </button>

            <a asp-page="Index" class="btn btn-secondary">
                Voltar
            </a>

        </form>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}