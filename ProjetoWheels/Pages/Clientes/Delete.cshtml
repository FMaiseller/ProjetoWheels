@page
@model ProjetoWheels.Pages.Clientes.DeleteModel
@{
}
<h1 class="mb-4 text-danger">
    Excluir Cliente
</h1>

<div class="card shadow-sm border-danger">

    <div class="card-body">

        <h5 class="mb-4">
            Tem certeza que deseja excluir este cliente?
        </h5>

        <dl class="row">

            <dt class="col-sm-2">
                Nome
            </dt>

            <dd class="col-sm-10">
                @Model.Cliente.Nome
            </dd>

            <dt class="col-sm-2">
                CPF
            </dt>

            <dd class="col-sm-10">
                @Model.Cliente.CPF
            </dd>

            <dt class="col-sm-2">
                Telefone
            </dt>

            <dd class="col-sm-10">
                @Model.Cliente.Telefone
            </dd>

            <dt class="col-sm-2">
                Email
            </dt>

            <dd class="col-sm-10">
                @Model.Cliente.Email
            </dd>

        </dl>

        <form method="post">

            <input type="hidden" asp-for="Cliente.Id" />

            <button type="submit" class="btn btn-danger">
                Excluir
            </button>

            <a asp-page="Index" class="btn btn-secondary">
                Cancelar
            </a>

        </form>

    </div>

</div>