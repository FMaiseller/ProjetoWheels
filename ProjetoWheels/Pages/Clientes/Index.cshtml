@page
@model ProjetoWheels.Pages.Clientes.IndexModel
@{
}

<h1>Clientes</h1>

<a asp-page="Create" class="btn btn-primary mb-3">
    Novo Cliente
</a>

<table class="table table-hover align-middle">
    <thead>
        <tr>
            <th>Nome</th>
            <th>CPF</th>
            <th>Telefone</th>
            <th>Email</th>
            <th></th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model.Clientes)
        {
            <tr>
                <td>@item.Nome</td>
                <td>@item.CPF</td>
                <td>@item.Telefone</td>
                <td>@item.Email</td>

                <td>
                    <a asp-page="Edit" asp-route-id="@item.Id"
                       class="btn btn-warning btn-sm">
                        Editar
                    </a>

                    @* <a asp-page="Delete" asp-route-id="@item.Id"
                       class="btn btn-danger btn-sm">
                        Excluir
                    </a> *@
                </td>
            </tr>
        }
    </tbody>
</table>