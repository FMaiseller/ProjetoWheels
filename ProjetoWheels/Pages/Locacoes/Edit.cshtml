@page
@model ProjetoWheels.Pages.Locacoes.EditModel
@{
}
<h1 class="mb-4">
    Editar Locação
</h1>

<div class="card shadow-sm">

    <div class="card-body">

        <form method="post">

            <input type="hidden"
                   asp-for="Locacao.Id" />

            <div class="mb-3">

                <label class="form-label">
                    Cliente
                </label>

                <input class="form-control"
                       value="@Model.Locacao.Cliente.Nome"
                       disabled />

            </div>

            <div class="mb-3">

                <label class="form-label">
                    Bicicleta
                </label>

                <input class="form-control"
                       value="@Model.Locacao.Bicicleta.Marca"
                       disabled />

            </div>

            <div class="mb-3">

                <label asp-for="Locacao.DataFimPrevista"
                       class="form-label"></label>

                <input asp-for="Locacao.DataFimPrevista"
                       type="date"
                       class="form-control" />

            </div>

            <div class="mb-3">

                <label asp-for="Locacao.DepositoPago"
                       class="form-label"></label>

                <input asp-for="Locacao.DepositoPago"
                       type="number"
                       step="0.01"
                       class="form-control" />

            </div>

            <button type="submit"
                    class="btn btn-warning">

                Salvar Alterações

            </button>

            <a asp-page="Index"
               class="btn btn-secondary">

                Voltar

            </a>

        </form>

    </div>

</div>