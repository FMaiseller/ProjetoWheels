@page
@model ProjetoWheels.Pages.Locacoes.IndexModel
@{
}
<h1 class="mb-4">
    Locações
</h1>

<a asp-page="Create"
   class="btn btn-primary mb-3">
    Nova Locação
</a>

<table class="table table-hover align-middle">

    <thead>

        <tr>
            <th>Cliente</th>
            <th>Bicicleta</th>
            <th>Marca da Bicicleta</th>
            <th>Início</th>
            <th>Fim</th>
            <th>Data Devolução</th>
            <th>Valor</th>
            <th>Valor Atraso</th>
            <th></th>
        </tr>

    </thead>

    <tbody>

        @foreach (var item in Model.Locacoes)
        {
            <tr>

                <td>
                    @item.Cliente.Nome
                </td>

                <td>
                    @item.Bicicleta.Id
                </td>

                <td>
                    @item.Bicicleta.Marca
                </td>

                <td>
                    @item.DataInicio.ToShortDateString()
                </td>

                <td>
                    @item.DataFimPrevista.ToShortDateString()
                </td>

                @if (item.DataDevolucao != null)
                {
                    <td>
                        @item.DataDevolucao
                    </td>
                }
                else {
                    <td>
                     Não devolvido
                    </td>
                }

                <td>
                    @item.ValorTotal.ToString("C")
                </td>

               
                <td>
                    @item.TaxaAtraso
                </td>
     

                <td>

                    <a asp-page="Edit"
                       asp-route-id="@item.Id"
                       class="btn btn-warning btn-sm">

                        Editar

                    </a>

                    @if (item.DataDevolucao == null)
                    {
                        <a asp-page="Devolver"
                        asp-route-id="@item.Id"
                        class="btn btn-success btn-sm">

                            Devolver

                        </a>
                    }

                </td>

            </tr>
        }

    </tbody>

</table>